{
  "name": "pjecalc-mcp-skill",
  "version": "2.16.0-mcp.18",
  "description": "Servidor MCP do PJe-Calc Cidadão 2.16.0: agentes de IA montam o cálculo trabalhista inteiro (processo, verbas e reflexos, cartão de ponto, FGTS, INSS, IR, honorários, custas, correção e juros), importado e pronto para liquidar.",
  "type": "module",
  "main": "server.mjs",
  "bin": {
    "pjecalc-mcp": "server.mjs"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node ../scripts/test-mcp.mjs && npm run test:regressao",
    "test:regressao": "node --experimental-vm-modules --test ../scripts/regressoes-calculos.test.mjs ../scripts/regressoes-instalador.test.mjs ../scripts/regressoes-integracao.test.mjs ../scripts/regressoes-validacao.test.mjs",
    "test:ponta-a-ponta": "node ../scripts/test-ponta-a-ponta.mjs todos"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "AGPL-3.0-only"
}
